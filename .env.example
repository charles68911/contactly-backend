APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production target: Neon PostgreSQL.
# Never commit real credentials. Leave these values blank in this example file.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Alternative: use one full Neon connection string instead of DB_HOST/_PORT/
# _DATABASE/_USERNAME/_PASSWORD. Run migrations against the direct (non-pooler)
# host; the pooled host is fine for the running application.
# DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15

# Gmail SMTP example. Replace the MAIL_* block above with these values;
# never commit real credentials.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=your-address@gmail.com
# MAIL_PASSWORD=your-16-character-app-password
# MAIL_FROM_ADDRESS=your-address@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_TIMEOUT=15

# Bearer tokens do not expire by default. Set this in minutes only if you
# intentionally want every token to expire.
# SANCTUM_EXPIRATION=

# Frontend URL used in password reset emails. Point this at the React app.
FRONTEND_URL=http://localhost:5173
# FRONTEND_PASSWORD_RESET_URL=${FRONTEND_URL}/reset-password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
